        {
          "name": "Refresh token (rotation)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Remember the current token so the next request can prove it cannot be reused",
                  "pm.collectionVariables.set(\"refreshTokenOld\", pm.collectionVariables.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK with NEW refresh token\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.refreshToken).to.not.eql(pm.collectionVariables.get(\"refreshTokenOld\"));",
                  "  pm.collectionVariables.set(\"customerToken\", body.accessToken);",
                  "  pm.collectionVariables.set(\"refreshToken\", body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
