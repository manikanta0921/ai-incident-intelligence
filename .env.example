# Copy this file to .env, replace the values with your own, and NEVER commit .env to git.
# These are example/fake values only.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/incident_db
DB_USERNAME=incident_user
DB_PASSWORD=change_me_local

# --- JWT ---
# Generate a strong secret locally with:
#   openssl rand -base64 64
# (minimum 32 bytes for HS256)
JWT_SECRET=replace-this-with-a-64-char-random-base64-secret-value!!
JWT_ACCESS_EXPIRATION=15
JWT_REFRESH_EXPIRATION=7

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
